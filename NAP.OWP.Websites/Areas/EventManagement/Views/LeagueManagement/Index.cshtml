@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title></title>
</head>
<body>
    <div class="body-content">

        <form class="filter">

            <div class="row margin-bottom-0">

                <div class="input-field col input--l">
                    <div class="label">League</div>
                    <input class="validate" placeholder="Search..." value="" id="username" type="text" >
                </div>               

                <div class="button-block col">
                    <a class="waves-effect waves-light btn btn-search">Search</a>
                </div>
            </div>

        </form>

        <div class="table">
            <table class="highlight striped">
                <thead>
                    <tr>
                        <th class="center no-col">#</th>
                        <th>OWP League</th>
                        <th class="action-col">Action</th>                        
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td class="center">1</td>
                        <td class="txt-uppercase">*English Premier League</td>
                        <td>
                            <i class="mdi mdi-check icon icon-check waves-effect waves-green"></i>
                            <i class="mdi mdi-close icon icon-close waves-effect waves-red"></i>
                        </td>
                    </tr>

                    <tr>
                        <td class="center">2</td>
                        <td class="txt-uppercase">*Italy serie a</td>
                        <td>
                            <i class="mdi mdi-pencil icon icon-edit waves-effect waves-orange"></i>
                        </td>
                    </tr>

                    <tr>
                        <td class="center">3</td>
                        <td class="txt-uppercase">*Germany - Bundesliga I</td>
                        <td>
                            <i class="mdi mdi-pencil icon icon-edit waves-effect waves-orange"></i>
                        </td>
                    </tr>

                    <tr>
                        <td class="center">4</td>
                        <td class="txt-uppercase">France Ligue 1</td>
                        <td>
                            <i class="mdi mdi-pencil icon icon-edit waves-effect waves-orange"></i>
                        </td>
                    </tr>

                    <tr>
                        <td class="center">5</td>
                        <td class="txt-uppercase">*LA liga</td>
                        <td>
                            <i class="mdi mdi-pencil icon icon-edit waves-effect waves-orange"></i>
                        </td>
                    </tr>

                </tbody>

            </table>

            <div class="pagination">
                <div class="detailtext left">Showing <span>1</span> to <span>20</span> of <span>142</span> entries</div>
                <ul class="border right">
                    <li class="footable-page-arrow"><a data-page="prev" href="#prev"><i class="icon mdi mdi-chevron-left"></i></a></li>
                    <li class="footable-page"><a data-page="0" href="#">1</a></li>
                    <li class="footable-page"><a data-page="1" href="#">2</a></li>
                    <li class="footable-page active"><a data-page="2" href="#">3</a></li>
                    <li class="footable-page-arrow disabled"><a data-page="next" href="#next"><i class="icon mdi mdi-chevron-right"></i></a></li>
                </ul>
            </div>
        </div>

    </div>
</body>
</html>
