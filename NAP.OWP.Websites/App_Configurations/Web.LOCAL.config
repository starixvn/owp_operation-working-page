<configuration>
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="NapSettings" type="Fanex.NAP.Core.Configuration.NapSettings, Fanex.NAP.Core.Client" />
    <sectionGroup name="bundleTransformer">
      <section name="core" type="BundleTransformer.Core.Configuration.CoreSettings, BundleTransformer.Core" />
    </sectionGroup>
    <sectionGroup name="jsEngineSwitcher">
      <section name="core" type="JavaScriptEngineSwitcher.Core.Configuration.CoreConfiguration, JavaScriptEngineSwitcher.Core" />
    </sectionGroup>
  </configSections>
  <appSettings file="App_Configurations\Web.LOCAL.AppSettings.config">
    <add key="ClientTimezone" value="8" />
    <add key="aspnet:MaxJsonDeserializerMembers" value="20971520" />
    <add key="EPPlus:ExcelPackage.LicenseContext" value="NonCommercial" />
    <add key="StoredProcedurePath" value="App_Data" />
    <add key="TRGS_Report_ApiEndpoint" value="http://ha.nexdev.net:7724/TGRS" />
    <add key="PropagationAuth" value="" />
    <add key="NetCoreRootUrl" value="" />
    <add key="ONEbook.UM:ServiceUri" value="https://onebookum-dev.nexdev.net/api" />
    <add key="ONEbook.UM:EnableCheckUM" value="false" />
    <add key="ONEbook.UM:SiteId" value="2000000" />
    <add key="ONEbook.UM:EnableUnscheduledUM" value="false" />
    <add key="ONEbook.UM:UMFrom" value="01:00" />
    <add key="ONEbook.UM:UMTo" value="23:00" />
    <add key="ONEbook.UM:UMPageUrl" value="~/Auth/Offline" />
    <add key="ONEbook.UM:ResultCacheDuration" value="60" />
    <add key="ONEbook.UM:UMLoggingCategory" value="ONEbook-UM" />
    <add key="ONEbook.UM:ErrorUMPageUrl" value="" />
    <add key="RabbitMQHosting" value="" />
    <add key="RabbitMQVirtualHost" value="" />
    <add key="RabbitMQUserName" value="" />
    <add key="RabbitMQPassword" value="" />
    <add key="RabbitMQPort" value="5672" />
    <add key="RabbitMQRequestQueue" value="" />
  </appSettings>
  <connectionStrings configSource="App_Configurations\Web.LOCAL.ConnectionStrings.config" />
  <NapSettings
     Environment="UAT"
     EnableDirectLogin="1"
     EnableOtp="0"
     SiteId="99"
     UnauthorizeUrl="~/Auth/AccessDenied"
     EnableReCheckin="false"
     HubUrl=""
     ServiceUrls="http://nap_api_netcore.nexdev.net:8787">
    <Domain>
    </Domain>
  </NapSettings>
  <system.web>
    <authentication mode="Forms">
      <forms ticketCompatibilityMode="Framework40" cookieless="UseCookies" name=".NAPOWPFORMSAUTH" protection="All" loginUrl="~/Auth" timeout="1440" defaultUrl="~/Home" />
    </authentication>
    <sessionState cookieName=".OWP_ASP.NET_SessionId" mode="StateServer" timeout="1500" stateConnectionString="tcpip=10.18.200.131:42424" />
    <machineKey validationKey="43D3FD4A7C3943055E41A79DD4DC28DF7500E4A0D92B0854C787C68FFD4192C853DB09D4FFEA2884806CBD2CCE9BF324F2046C490AC54EEB3B58B3B840CD0458" decryptionKey="29D1CA3CBD2619B793551301FA2386553B88AB2FC6806408A33C74E53E8AC12D" validation="SHA1" decryption="AES" />
    <customErrors mode="Off" defaultRedirect="~/Auth/Error">
      <error statusCode="403" redirect="~/Auth/AccessDenied" />
    </customErrors>
    <compilation debug="true" targetFramework="4.7.2">      
    </compilation>
    <httpRuntime targetFramework="4.7.2" requestPathInvalidCharacters="" maxRequestLength="5120"/>
	<pages validateRequest="false" />
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false"/>
    <modules runAllManagedModulesForAllRequests="true">
      <remove name="WebDAVModule"/>
    </modules>
    <handlers>
      <remove name="WebDAV"/>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0"/>
      <remove name="OPTIONSVerbHandler"/>
      <remove name="TRACEVerbHandler"/>
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0"/>
      <add name="LessAssetHandler" path="*.less" verb="GET" type="BundleTransformer.Less.HttpHandlers.LessAssetHandler, BundleTransformer.Less" resourceType="File" preCondition=""/>
    </handlers>
    <staticContent>
      <clientCache cacheControlCustom="public" cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00"/>
      <remove fileExtension=".woff"/>
      <remove fileExtension=".woff2"/>
      <remove fileExtension=".ttf"/>
      <remove fileExtension=".json"/>
      <mimeMap fileExtension=".json" mimeType="application/json"/>
      <mimeMap fileExtension=".woff" mimeType="application/x-font-woff"/>
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff2"/>
      <mimeMap fileExtension=".ttf" mimeType="application/font-ttf"/>
    </staticContent>
  </system.webServer>
